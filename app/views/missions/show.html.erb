<%= render "shared/navbar" %>

<% if @mission.users.include?(current_user) %>

  <div class="missions-card-inscrit">
    <h1><%= @mission.nom %></h1>
    <% if @mission.photo.attached?%>
      <%= cl_image_tag @mission.photo.key, height: 350, width: 428, crop: :fill %>
    <% end %>
    <h3><%= @mission.asso.nom %></h3>
    <p><%= @mission.localisation %></p>
    <p><%= @mission.description %></p>
  </div>
  <h1>join the chat </h1>
<%= link_to cancel_mission_path(@mission), method: :get, data: { confirm: "Êtes-vous sûr de vouloir annuler cette mission ?" }, class: "cancel-button" do %>
  <%= image_tag "cancel.png", class: "image-class" %>
<% end %>

  <% else %>

  <div class="missions-card-non-inscrit">
      <h1 class="mission-card"><%= @mission.nom %></h1>
      <% if @mission.photo.attached?%>
        <%= cl_image_tag @mission.photo.key, height: 350, width: 428, crop: :fill %>
      <% end %>
      <h3 class="headerpage"><%= @mission.asso.nom %></h3>
    <div class=card-info>
      <div class="ensemble">
        <%= link_to confirmation_path do %>
        <%= image_tag "tictac.png", class:"tictac-button"%>
        <% end %>
        <%= link_to confirmation_path do %>
        <%= image_tag "localisation.png", class:"loca-card"%>
        <% end %>
      </div>
      <div class="joker">
        <p><%= @mission.temps%></p>
        <p><%= @mission.localisation %></p>
      </div>
    </div>
  </div>
  <p class="descri"><%= @mission.description %></p>
<%= simple_form_for [@mission, @reservation], class: "button-form" do |f| %>
      <%= f.button :submit, "Je participe", class: "submit-button"%>
    <% end %>
<% end %>
