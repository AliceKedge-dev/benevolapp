<div class="navbar-home">

  <h1><i class="fa-solid fa-bolt" style="color: #ffc21c;"></i>Benevol'App<i class="fa-solid fa-bolt" style="color: #ffc21c;"></i></h1>

  <style>
    .dropdown-content {
      display: none;
    }
  </style>

  <div class="dropdown">

      <% if user_signed_in? %>
    <% if current_user.photo.attached? %>
    <%= cl_image_tag current_user.photo.key, class:"profile_link", id: "dropdown-trigger" %>
    <% else  %>
    <%= image_tag('chien.png') %>
    <% end %>
        <% end %>


    <div class="dropdown-content">
      <% if user_signed_in? %>
        <%= link_to "Profil", profile_path, class: "dropdown-item" %>
        <%= link_to "Déconnexion", destroy_user_session_path, class: "dropdown-item" %>
      <% else %>
        <%= link_to "Connexion", new_user_session_path, class: "dropdown-item" %>
      <% end %>
    </div>

  </div>



</div>

<br><br><br>


<div class="intro">
<%= image_tag("intro.png", alt: "hello") %>
</div>

<div class="home-map">

 <%= link_to map_path do %>
    <%= image_tag "mapfleche.png", class:"mapexpander"%>
  <% end %>

  <div class="test" style="width: 100%; height: 605px"
    data-controller="map"
    data-map-markers-value="<%= @markers.to_json %>"
    data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>">

      <% if user_signed_in? %>
  <% if !current_user.missions.empty? %>
    <%= link_to mesmissions_path do %>
    <%= image_tag "mesmissions.png", class:"mes_missions"%>
  <% end %>
    <% end %>

  <% end %>

  <%= link_to missions_path do %>
    <%= image_tag "trouveuneactivité.png", class:"list_mission"%>
  <% end %>

  </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
      event.preventDefault();
      var dropdownTrigger = document.getElementById("dropdown-trigger");
      var dropdownContent = document.querySelector(".dropdown-content");

      dropdownTrigger.addEventListener("click", function() {
        dropdownContent.style.display = dropdownContent.style.display === "none" ? "block" : "none";
      });
    });
  </script>
