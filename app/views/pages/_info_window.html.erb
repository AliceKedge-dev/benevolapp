<div class ="info-window">

<h2><%= mission.nom.capitalize %></h2>
<%= cl_image_tag mission.photo.key, height: 140, width: 200, crop: :fill, class:"card-photo-img-info"%>

<p class = "category-info-card"><%= mission.category.capitalize %></p>
<p class = "localisation-info-card"><%= mission.localisation %></p>

  <%= link_to mission_path(mission) do %>
  <%= image_tag("more.png", alt: "Home", class: "more-button") %>
<% end %>

</div>
