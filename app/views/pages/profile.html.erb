
<div class = "navbar-profile">

  <div class ="elements-nav-home">
    <%= link_to :back do %>
      <%= image_tag "back.png", class:"back-link-profile"%>
    <% end %>

    <%= link_to root_path do %>
      <%= image_tag("home.png", alt: "Home", class: "home-button") %>
    <% end %>
  </div>

  <div class ="forme-verte-navbar">
    <%= image_tag "forme-verte-profile.png", class:"formeverte"%>
  </div>

</div>

<div class = "user_profile_card">
        <% if current_user.photo %>
          <%= cl_image_tag current_user.photo.key, class: "pic_profile_card" %>
        <% end %>
        <h3 class="profile_name"><%= current_user.username.upcase %></h3>
</div>

  <div class ="forme-bleu-profile">
    <%= image_tag "forme-bleu-profile.png", class:"formebleu"%>
  </div>

<div class="allbtn">

<div class = "boutons-profil">

      <%= link_to chatrooms_path(@chatroom) do %>
        <%= image_tag "msg-btn.png", class:"messages-btn"%>
      <% end %>

      <%= link_to mesmissions_path do %>
        <%= image_tag "mesmissions-btn.png", class:"mesmissions-btn"%>
      <% end %>

      <%= link_to root_path do %>
        <%= image_tag "settings-button.png", class:"settings-btn"%>
      <% end %>

  </div>

    <h1 class = "badge-name">Mes badges et progressions!</h1>
    <div class = "badge-section">
      <%= image_tag @url_animal %>
      <%= image_tag @url_social %>
      <%= image_tag @url_environnement %>
    </div>

 <div class ="forme-jaune-profile">
    <%= image_tag "formejaune.png", class:"formejaune"%>
  </div>


<div class = "progression-card-profile">

  <h2>ENVIRONNEMENTAL</h2>
  <p>PROGRESSION EN COURS ...</p>
<div class="category-name-first pr-1">
  <div class="progress col-8" style="height: 9px">
    <div class="progress-bar bg-environnement" role="progressbar" style="width: <%= (current_user.environnement_count.to_f / 3) * 100 %>%" aria-valuenow="<%= current_user.environnement_count %>" aria-valuemin="0" aria-valuemax="3"></div>
      </div>
  <%= link_to environnement_progression_path do %>
    <button class ="button-envrn">
      <p class="progression-chiffre"><%= current_user.environnement_count %>/3</p>
    </button>
  <% end %>
</div>

<h2>SOCIAL</h2>
<p>PROGRESSION EN COURS ...</p>
<div class="category-name-first pr-1">
  <div class="progress col-8" style="height: 9px">
    <div class="progress-bar bg-social" role="progressbar" style="width: <%= (current_user.social_count.to_f / 3) * 100 %>%" aria-valuenow="<%= current_user.social_count %>" aria-valuemin="0" aria-valuemax="3"></div>
      </div>
  <%= link_to social_progression_path do %>
    <button class ="button-social">
        <p class="progression-chiffre"><%= current_user.social_count %>/3</p>
    </button>
  <% end %>
</div>

<h2>ANIMAL</h2>
<p>PROGRESSION EN COURS ...</p>
<div class="category-name-first pr-1">
  <div class="progress col-8" style="height: 9px">
    <div class="progress-bar bg-animal" role="progressbar" style="width: <%= (current_user.animal_count.to_f / 3) * 100 %>%" aria-valuenow="<%= current_user.animal_count %>" aria-valuemin="0" aria-valuemax="3"></div>
      </div>
  <%= link_to animal_progression_path do %>
    <button class ="button-animal">
      <p class="progression-chiffre"><%= current_user.animal_count %>/3</p>
    </button>
  <% end %>
</div>


</div>
</div>
</div>
