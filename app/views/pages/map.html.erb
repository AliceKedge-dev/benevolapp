<div class="navmap">

<div class ="back-home">
  <%= link_to :back do %>
    <%= image_tag "back.png", class:"back-link"%>
  <% end %>

  <%= link_to root_path do %>
    <%= image_tag("home.png", alt: "Home", class: "home-button") %>
  <% end %>
</div>

    <div id="menu">
      <input id="satellite-streets-v12" type="radio" name="rtoggle" value="satellite" checked="checked" style="display: none">
      <label for="satellite-streets-v12">
        <%= image_tag("satellite-gris.png", id: "satellite-gris") %>
        <%= image_tag("satellite-vert.png", id: "satellite-vert", style: "display: none") %>
      </label>

      <input id="streets-v12" type="radio" name="rtoggle" value="streets" checked="checked" style="display: none">
      <label for="streets-v12" id="map-logo-label">
        <%= image_tag("map-gris.png", id: "map-gris") %>
        <%= image_tag("map-vert.png", id: "map-vert", style: "display: none") %>
      </label>
    </div>

    <%= link_to profile_path do %>
      <div>
          <% if current_user %>
            <%= cl_image_tag current_user.photo.key, class:"profile_link" %>
          <% end %>
      </div>

    <% end %>

</div>


<div class="map-fullpage">


  <div class="test" style="width: 100%; height: 90vh"
    data-controller="map"
    data-map-markers-value="<%= @markers.to_json %>"
    data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>">

    <% if !current_user.missions.empty? %>
  <%= link_to mesmissions_path do %>
    <%= image_tag "mesmissions.png", class:"mes_missions"%>
  <% end %>
  <% end %>

    <%= link_to missions_path do %>
      <%= image_tag "trouveuneactivité.png", class:"list_mission-map"%>
    <% end %>

  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const satelliteGris = document.getElementById("satellite-gris");
    const satelliteVert = document.getElementById("satellite-vert");
    const mapGris = document.getElementById("map-gris");
    const mapVert = document.getElementById("map-vert");

    satelliteGris.addEventListener("click", function() {
      satelliteVert.style.display = "inline-block";
      satelliteGris.style.display = "none";
      mapGris.style.display = "none";
      mapVert.style.display = "inline-block";
    });

    satelliteVert.addEventListener("click", function() {
      satelliteGris.style.display = "inline-block";
      satelliteVert.style.display = "none";
      mapGris.style.display = "inline-block";
      mapVert.style.display = "none";
    });

    mapGris.addEventListener("click", function() {
      mapVert.style.display = "inline-block";
      mapGris.style.display = "none";
      satelliteGris.style.display = "none";
      satelliteVert.style.display = "inline-block";
    });

    mapVert.addEventListener("click", function() {
      mapGris.style.display = "inline-block";
      mapVert.style.display = "none";
      satelliteGris.style.display = "inline-block";
      satelliteVert.style.display = "none";
    });
  });
</script>
