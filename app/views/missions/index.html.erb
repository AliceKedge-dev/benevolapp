<%= render "shared/navbar" %>

<h2>FLASH BENEVOLAT <i class="fa-solid fa-bolt" style="color: #ffc21c;"></i></h2>

<div class="dropdown-filtres">
<div class="img-filtres">
<div class="dropdown">
  <%= image_tag("filtres_gris.png", alt: "hello", id:"filtres_gris")%>
  <%= image_tag("filtres_bleu.png", alt: "hello", id:"filtres_bleu", style: "display: none")%>
  <div class="dropdown-content">
    <% Mission.all.each do |category| %>
      <%= link_to category.category, filter_missions_path(category.category), class: "dropdown-item-filter" %>
    <% end %>
  </div>
</div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function() {
    var filtres_gris = document.getElementById("filtres_gris");
    var filtres_bleu = document.getElementById("filtres_bleu");

    filtres_gris.addEventListener("click", function() {
      filtres_gris.style.display = "none";
      filtres_bleu.style.display = "inline-block";
    });

    filtres_bleu.addEventListener("click", function() {
      filtres_bleu.style.display = "none";
      filtres_gris.style.display = "inline-block"
    });
});
</script>

<%= form_tag(search_path, method: :get, class: "search-form") do %>
  <%= text_field_tag(:query, params[:query], placeholder: "  Rechercher...") %>
  <button type="submit" class="search-button">
    <i class="fa-solid fa-magnifying-glass" style="color: #FFFFFF;"></i>
  </button>
<% end %>
</div>



<div class="card-container">
  <% @missions.each do |mission, asso| %>
    <%= content_tag :div, class: 'card' do %>
      <%= link_to mission_path(mission), class: 'card-link' do %>
        <%= content_tag :div, class: 'card-content' do %>
        <% if mission.photo.attached?%>
          <%= cl_image_tag mission.asso.photo.key, height: 70, width: 70, crop: :fill, class:"card-info card-photo-asso" %>
          <%= cl_image_tag mission.photo.key, height: 300, width: 386, crop: :fill, class:"card-photo-img"%>
        <% end %>


    <h2 class="card-name"><%= mission.nom %></h2>
    <h2 class="card-asso"><%= mission.asso.nom %></h2>

<div class="card-color" style="display: grid; justify-content: space-around; grid-template-columns: 1fr 1fr 1fr;">
 <div class="icon-loca">
 <i class="fa-solid fa-location-dot"></i>
    <p class=" card-loca"><%= mission.localisation %></p>
</div>
<div class="icon-cate">
<i class="fa-solid fa-filter"></i>
    <p class=" card-cate"><%= mission.category %></p>
</div>
<div class="icon-tps">
<i class="fa-solid fa-clock"></i>
    <p class=" card-tps"><%= mission.temps %>h</p>
</div>
</div>

        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
